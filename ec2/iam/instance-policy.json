{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HibernateSelf",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Name": "devbox" } }
    },
    {
      "Sid": "ReadBootstrapSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*:*:parameter/devbox/*"
    }
  ]
}
