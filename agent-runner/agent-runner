#!/usr/bin/env bash
# Picks up open GitHub issues labeled "agent", has Claude Code implement each one
# in a git worktree of the local checkout, and opens a PR.
#
# Usage: agent-runner [--dry-run]
# Runs from cron (see crontab -l).
#
# Label lifecycle on an issue:
#   agent -> agent-wip (while running) -> agent-pr | agent-needs-human | agent-failed
#
# To continue after agent-needs-human, answer in an issue comment and re-add "agent".
# Re-adding "agent" to an issue whose branch already exists resumes on that branch
# (and updates its open PR), so it also works for follow-up changes or questions.
# Adding "agent" to that PR, or submitting a code review on it, does the same: the run
# is for the PR's issue, and gets the PR's discussion and review comments too.
#
# Each issue's worktree (~/.agent-runner/worktrees/<repo>-<N>) is kept until the issue
# is closed. Agents read and extend RUNNER-AGENTS.md in each repo with what they learn.

set -euo pipefail

# Local checkouts to watch, one per line: "<path> [files to link into the worktree...]".
# Linked files are untracked secrets/config that exist only in the main checkout;
# globs expand relative to the checkout.
# Config, logs and worktrees are machine-specific (and may contain secrets), so they all
# live in one untracked directory outside the repo.
STATE_DIR="${AGENT_RUNNER_HOME:-$HOME/.agent-runner}"
CONFIG="$STATE_DIR/repos"
WORKTREE_ROOT="$STATE_DIR/worktrees"
LOG_DIR="$STATE_DIR/logs"
REVIEWS_SEEN="$STATE_DIR/reviews-seen"

# Issue labels. The trigger is the one you add by hand; the rest are created on the
# first run and set by this script.
LABEL_TRIGGER="agent"
LABEL_WIP="agent-wip"
LABEL_PR="agent-pr"
LABEL_NEEDS_HUMAN="agent-needs-human"
LABEL_FAILED="agent-failed"
MAX_TURNS=200

# Tools the agent may use without prompting. It can edit files and run the project's
# tooling, but pushing and PR creation are done by this script, not the agent.
ALLOWED_TOOLS=(
  Read Edit Write Glob Grep TodoWrite
  "Bash(npm *)" "Bash(npx *)" "Bash(node *)" "Bash(pnpm *)"
  "Bash(python *)" "Bash(python3 *)" "Bash(pip *)" "Bash(uv *)" "Bash(pytest *)"
  "Bash(ls *)" "Bash(cat *)" "Bash(head *)" "Bash(tail *)" "Bash(wc *)"
  "Bash(find *)" "Bash(grep *)" "Bash(rg *)" "Bash(mkdir *)" "Bash(mv *)" "Bash(cp *)"
  "Bash(git status*)" "Bash(git diff*)" "Bash(git log*)" "Bash(git show*)"
  "Bash(git add *)" "Bash(git commit *)"
)

# The agent's final answer. "needs_human" is for real blockers only (see the prompt).
RESULT_SCHEMA='{
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["done", "needs_human"]},
    "summary": {"type": "string", "description": "PR description (markdown), laid out as the prompt says: what the reviewer must act on above the fold, the log of the work below it"},
    "decisions": {"type": "array", "items": {"type": "string"}, "description": "Judgment calls made where the issue was ambiguous, each a terse fragment"},
    "question": {"type": "string", "description": "When needs_human: the specific question(s) to answer, question first, a few lines at most"}
  },
  "required": ["status", "summary"]
}'

# Commits and PRs carry no Claude attribution (no Co-Authored-By trailer, no
# "Generated with Claude Code" line); commits are authored by this machine's git identity.
CLAUDE_SETTINGS='{"attribution": {"commit": "", "pr": ""}, "includeCoAuthoredBy": false}'

DRY_RUN=false
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=true

mkdir -p "$WORKTREE_ROOT" "$LOG_DIR"

# One run at a time; a long implementation shouldn't overlap the next tick.
# Flock is a tool that handles concurrency and race conditions
exec 9>"$STATE_DIR/lock"
flock -n 9 || { echo "Another run is in progress, exiting."; exit 0; }

log() { echo "[$(date '+%F %T')] $*"; }

ensure_labels() {
  local repo=$1
  gh label create "$LABEL_WIP"         -R "$repo" --color FBCA04 --description "Agent is working on this" 2>/dev/null || true
  gh label create "$LABEL_PR"          -R "$repo" --color 0E8A16 --description "Agent opened a PR" 2>/dev/null || true
  gh label create "$LABEL_NEEDS_HUMAN" -R "$repo" --color 5319E7 --description "Agent is blocked on a question; answer, then re-add '$LABEL_TRIGGER'" 2>/dev/null || true
  gh label create "$LABEL_FAILED"      -R "$repo" --color B60205 --description "Agent run failed" 2>/dev/null || true
}

# The part of a failed git/gh command's output that says why, as a markdown quote
# for an issue comment, plus a hint for causes this script knows how to fix.
failure_reason() { # <command output>
  local lines
  # git marks the rejected ref with " ! "; otherwise the last lines carry the error
  lines=$(grep -E '^ ! ' <<<"$1" | sed 's/^ ! //' | head -n 3 || true)
  [[ -n "$lines" ]] || lines=$(grep -v '^[[:space:]]*$' <<<"$1" | tail -n 3 || true)
  sed 's/^/> /' <<<"${lines:-(no output)}"
  if grep -q 'without `workflow` scope' <<<"$1"; then
    echo
    echo "The branch changes a file under \`.github/workflows/\`, which GitHub only accepts from a token with the \`workflow\` scope. Add that scope to the runner's token, then re-add \`$LABEL_TRIGGER\`."
  fi
}

# Reviews a run has already been given, one "<repo>#<pr> <review id>" per line, so a
# submitted review triggers one run, not one per tick.
review_seen() { # <repo> <pr number> <review id>
  [[ -f "$REVIEWS_SEEN" ]] && grep -qxF "$1#$2 $3" "$REVIEWS_SEEN"
}

# The issues whose open PR asks for a run: one "<issue number> <reason>" line per PR
# that carries the trigger label or has a submitted review no run has seen yet.
# Only PRs on this script's own agent/issue-N branches count; the branch names the issue.
pr_triggers() { # <repo>
  local repo=$1 issue pr kind id
  # Reviews by people with write access only, like the label. A bare approval asks for nothing.
  gh pr list -R "$repo" --state open --limit 100 --json number,headRefName,labels,reviews --jq "
    .[] | select(.headRefName | test(\"^agent/issue-[0-9]+\$\"))
    | (.headRefName | ltrimstr(\"agent/issue-\")) as \$issue | .number as \$pr
    | (select([.labels[].name] | index(\"$LABEL_TRIGGER\")) | [\$issue, \$pr, \"label\", \"-\"]),
      (.reviews[]
        | select(.authorAssociation == \"OWNER\" or .authorAssociation == \"MEMBER\" or .authorAssociation == \"COLLABORATOR\")
        | select(.state == \"COMMENTED\" or .state == \"CHANGES_REQUESTED\" or (.state == \"APPROVED\" and .body != \"\"))
        | [\$issue, \$pr, \"review\", .id])
    | @tsv" |
  while IFS=$'\t' read -r issue pr kind id; do
    if [[ $kind == label ]]; then
      echo "$issue '$LABEL_TRIGGER' label on PR #$pr"
    elif ! review_seen "$repo" "$pr" "$id"; then
      echo "$issue code review on PR #$pr"
    fi
  done | sort -u -k1,1n
}

# An open PR's discussion, reviews and inline review threads as markdown for the prompt.
# Reviews no earlier run was given are marked as new. Draft (pending) reviews and their
# comments are visible to this token but not submitted yet, so they are left out.
pr_context() { # <repo> <pr number>
  local repo=$1 pr=$2 seen=""
  [[ -f "$REVIEWS_SEEN" ]] && seen=$(grep -F "$repo#$pr " "$REVIEWS_SEEN" | cut -d' ' -f2 || true)
  # shellcheck disable=SC2016  # the $variables belong to GraphQL and jq
  gh api graphql -f owner="${repo%/*}" -f name="${repo#*/}" -F number="$pr" -f query='
    query($owner: String!, $name: String!, $number: Int!) {
      repository(owner: $owner, name: $name) { pullRequest(number: $number) {
        url
        comments(last: 100) { nodes { author { login } body createdAt } }
        reviews(last: 100) { nodes { id author { login } state body submittedAt } }
        reviewThreads(last: 100) { nodes {
          isResolved isOutdated path line originalLine
          comments(first: 50) { nodes { author { login } body state createdAt diffHunk } }
        } }
      } }
    }' | jq -r --arg seen "$seen" '
    ($seen | split("\n")) as $seen
    | .data.repository.pullRequest
    | [.reviews.nodes[] | select(.state != "PENDING")] as $reviews
    | [.reviewThreads.nodes[]
        | .comments.nodes |= map(select(.state != "PENDING"))
        | select(.comments.nodes | length > 0)] as $threads
    | "# Pull request for this issue\n\(.url)\n\n"
      + ([.comments.nodes[] | "## PR comment by \(.author.login) (\(.createdAt))\n\(.body)"] | join("\n\n"))
      + "\n\n"
      + ([$reviews[]
          | "## Code review by \(.author.login) (\(.submittedAt), \(.state | ascii_downcase | gsub("_"; " ")))"
            + (if .id as $id | $seen | index($id) then "" else " [new since the last run]" end)
            + "\n" + (if .body == "" then "(no summary; see the inline comments)" else .body end)]
        | join("\n\n"))
      + "\n\n"
      + ([$threads[]
          | "## Inline review thread on \(.path)"
            + (if (.line // .originalLine) then ":\(.line // .originalLine)" else "" end)
            + (if .isResolved then " [resolved]" else "" end)
            + (if .isOutdated then " [outdated: the code has changed since]" else "" end)
            + "\n```diff\n" + (.comments.nodes[0].diffHunk | split("\n") | .[-6:] | join("\n")) + "\n```\n"
            + ([.comments.nodes[] | "\(.author.login) (\(.createdAt)): \(.body)"] | join("\n\n"))]
        | join("\n\n"))'
}

# Record every submitted review on a PR as seen (called when a run picks the PR up).
mark_reviews_seen() { # <repo> <pr number>
  local repo=$1 pr=$2 id
  gh pr view "$pr" -R "$repo" --json reviews --jq '.reviews[] | select(.state != "PENDING") | .id' |
  while read -r id; do
    review_seen "$repo" "$pr" "$id" || echo "$repo#$pr $id" >>"$REVIEWS_SEEN"
  done
}

process_issue() {

  # Take in the arguments and set variables
  # $1 = first arg given, $2 = second arg given, etc.
  # $6 is set when the run was asked for on the issue's PR (label or code review)
  local dir=$1 repo=$2 base=$3 links=$4 number=$5 pr_reason=${6:-}
  local name branch wt logfile
  name=$(basename "$dir")
  branch="agent/issue-$number"
  wt="$WORKTREE_ROOT/$name-$number"
  logfile="$LOG_DIR/$name-$number-$(date +%Y%m%d-%H%M%S).json"

  # Get the issue title, body, url and comments
  local issue title
  issue=$(gh issue view "$number" -R "$repo" --json title,body,url,comments \
    --jq '"# \(.title)\n\(.url)\n\n\(.body)\n\n" + ([.comments[] | "## Comment by \(.author.login)\n\(.body)"] | join("\n\n"))')
  title=$(gh issue view "$number" -R "$repo" --json title --jq .title)

  # Fetch the latest origin/base branch
  git -C "$dir" fetch --quiet origin

  # Set the start branch to the origin/base branch
  local start="origin/$base" resumed=false
  if git -C "$dir" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
    start="origin/$branch" resumed=true
  fi

  # If the dry run flag is set, log the dry run message and return
  # without actually doing anything
  if $DRY_RUN; then
    log "[dry-run] would implement $repo#$number: $title (branch $branch from $start)${pr_reason:+, triggered by $pr_reason}"
    return
  fi

  # Add the $LABEL_WIP label to the issue and remove the trigger label
  log "Picking up $repo#$number: $title (from $start)${pr_reason:+, triggered by $pr_reason}"
  gh issue edit "$number" -R "$repo" --add-label "$LABEL_WIP" \
    --remove-label "$LABEL_TRIGGER" --remove-label "$LABEL_NEEDS_HUMAN" --remove-label "$LABEL_FAILED" >/dev/null

  # The issue's open PR, if it has one. Every run gets its discussion and reviews, so
  # whatever triggered this run, the PR's own triggers are used up: drop its label and
  # remember its reviews.
  local pr_number pr_thread=""
  pr_number=$(gh pr list -R "$repo" --head "$branch" --state open --json number --jq '.[0].number // empty')
  if [[ -n "$pr_number" ]]; then
    pr_thread=$(pr_context "$repo" "$pr_number") || log "Couldn't read PR #$pr_number of $repo"
    gh pr edit "$pr_number" -R "$repo" --remove-label "$LABEL_TRIGGER" >/dev/null 2>&1 || true
    mark_reviews_seen "$repo" "$pr_number" || true
  fi

  # Define a function to finish the issue by removing the '$LABEL_WIP' label and
  # adding the given label and commenting on the issue. A run asked for on the PR
  # reports there too, since that's where the reviewer is looking.
  finish() { # <label> <comment>
    gh issue edit "$number" -R "$repo" --remove-label "$LABEL_WIP" --add-label "$1" >/dev/null
    gh issue comment "$number" -R "$repo" --body "$2" >/dev/null
    if [[ -n "$pr_reason" && -n "$pr_number" && "$2" != "🤖 Updated "* ]]; then
      gh pr comment "$pr_number" -R "$repo" --body "$2" >/dev/null || true
    fi
  }

  # The worktree lives until the issue is closed (see cleanup_worktrees), so installed
  # dependencies survive between runs and the reviewer can run the branch from it.
  # Reuse it if it exists, reset to the pushed branch; otherwise create it.
  # If that fails, finish the issue by adding the '$LABEL_FAILED' label
  git -C "$dir" worktree prune
  # A worktree whose metadata in $dir/.git/worktrees is gone (e.g. .git was replaced
  # by a copy from another machine) is no longer a checkout; remove it so it's recreated.
  if [[ -d "$wt" ]] && [[ $(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) != "$(cd "$wt" && pwd -P)" ]]; then
    log "Worktree $wt is orphaned, recreating it"
    rm -rf "$wt"
  fi
  if [[ -d "$wt" ]]; then
    # Commits an earlier run made but couldn't push exist only in the worktree;
    # continue from them instead of resetting them away.
    local target=$start
    if [[ -n $(git -C "$wt" log --oneline "$start..HEAD" 2>/dev/null) ]]; then
      log "Keeping unpushed commits in $wt"
      target=HEAD resumed=true
    fi
    if ! git -C "$wt" reset --quiet --hard "$target"; then
      finish "$LABEL_FAILED" "🤖 Couldn't reset the worktree \`$wt\` to \`$start\` on the runner."
      return 1
    fi
  elif ! git -C "$dir" worktree add --quiet -B "$branch" "$wt" "$start"; then
    finish "$LABEL_FAILED" "🤖 Couldn't create a worktree for \`$branch\` on the runner."
    return 1
  fi
  git -C "$wt" branch --quiet --unset-upstream 2>/dev/null || true

  # Link untracked secrets from the main checkout (globs expand relative to $dir).
  # which secrets to symlink is defined in the CONFIG file
  local pattern src rel
  for pattern in $links; do
    for src in "$dir"/$pattern; do
      [[ -e "$src" ]] || continue
      rel=${src#"$dir"/}
      mkdir -p "$(dirname "$wt/$rel")"
      ln -sf "$src" "$wt/$rel"
    done
  done

  local resume_note=""
  $resumed && resume_note="
This branch already has earlier work on this issue (see git log). Continue from it; newer
issue comments may answer questions from a previous run or ask for changes. If the newest
comments ask a question or ask for something other than code changes, answer them in
\"summary\" (it is posted as your reply); no commit is needed in that case."
  [[ -n "$pr_thread" ]] && resume_note="
$pr_thread
$resume_note

The pull request's discussion, code reviews and inline review threads above are the reviewer's
feedback on the implementation; the issue stays the source of truth for what to build. Action
the feedback that later commits haven't already dealt with (compare the timestamps with git
log; resolved threads are done), the same way you would a new issue comment.${pr_reason:+
This run was triggered by: $pr_reason.}"

  # Define the prompt passed to the implementing agent (a heredoc, so quotes need no escaping)
  local prompt
  prompt=$(cat <<EOF
You are running unattended to implement a GitHub issue in this repository.
Nobody is watching this session, so you can't ask questions mid-run.

$issue
$resume_note

Your working directory, $wt, is a git worktree that stays in place until the
issue is closed, so commands you give the reviewer (e.g. to run the branch) can point at it.

Instructions:
- Read RUNNER-AGENTS.md and CLAUDE.md (if present) and the relevant code before changing
  anything. RUNNER-AGENTS.md holds what earlier runner agents learned about working in this
  repo unattended; follow it.
- Implement the change the issue asks for. Keep the change focused on the issue.
- If dependencies aren't installed (e.g. no node_modules), install them first.
- Run the relevant tests/build and fix failures you introduced.
- Commit your work on the current branch with clear messages. Do not push; do not switch branches.
- Never add Co-Authored-By trailers, "Generated with Claude Code" notes, or any other AI/Claude
  attribution to commits, code, docs or your summary.
- Do not commit secrets or files like .env (they are symlinks to the main checkout).
- If this run taught you something about working in this repo as an unattended runner agent
  that a future run would otherwise have to rediscover (reviewer feedback in the comments,
  a tool or permission limit, a command that doesn't work here, how the reviewer wants to
  verify changes), add it to RUNNER-AGENTS.md at the repo root (create it if missing) and
  commit it. Keep entries short and specific; update an existing entry instead of adding a
  near-duplicate. Only runner-specific learnings belong there, not general docs, and nothing
  this prompt already tells you.

Making decisions:
- Bias strongly toward deciding and finishing. When the issue is ambiguous or leaves details
  open (naming, copy, layout, which of several reasonable approaches, edge-case behavior),
  pick the option most consistent with the existing code and the issue's intent, implement
  it, and record it in "decisions" so the reviewer can push back on the PR. A reviewer
  changing a decision later is cheap; a stalled issue is not.
- Return status "needs_human" only as a last resort, when you truly cannot proceed
  responsibly: the goal itself is unclear enough that any implementation is likely wrong,
  it needs access/credentials/external setup you don't have, or it requires an
  irreversible or high-risk choice (data deletion, breaking public APIs, security or billing
  behavior) the issue doesn't settle.
- If you return needs_human, commit any useful progress first, and put specific,
  answerable questions in "question" (with your recommended answer where you have one).

Writing "summary", "decisions" and "question":
The reviewer reads these on GitHub, busy and distracted, and reads the diff themselves.
Write for skimming: what they have to act on comes first, your log of the work goes below
the fold. Lay out "summary" in this order:
1. One or two sentences saying what the change does. No heading, and no "Closes #N" line
   (the runner adds it).
2. "### Audit": the bare minimum the reviewer needs to check the change by hand: the
   command to paste in a fenced code block, then what to open or look at. Leave the section
   out if there is nothing to check by hand.
3. Rarely, one more short section above the fold for anything else the reviewer must know
   to review the change properly: a behavior change they wouldn't expect from the issue, a
   risk, a part left undone, a step they have to take before merging. The bar is high: it
   must be actionable and consequential for the review. If in doubt it goes below the fold.
4. The fold: a line "<br />" followed by a line "<hr />".
5. "### Code changes": one bullet per file or area touched.
6. "### Agent-run verification": what you ran, and what you could not check.
The runner appends "decisions" last, under "### Agent decisions", so don't repeat them in
"summary".

- Below the fold and in "decisions", write stripped-down fragments, dropping articles and
  filler where the meaning survives: "Link opens new tab, hardcoded to <url>", not "The link
  opens in a new tab so that the live dashboard stays open".
- Don't explain what anyone who knows the technology already knows, and don't justify a
  decision unless the reason is surprising.
- Say each thing once, and scale to the change: a one-line fix gets a sentence above the
  fold and a line or two below it.
- "question", and a "summary" that only answers a comment, are posted as issue comments:
  put the question or the answer in the first line, then only the context needed to act on
  it. No sections.

Your final response must match the output schema: "summary" becomes the PR description.
EOF
)

  # Run the agent with the 'claude' CLI tool
  local rc=0
  (cd "$wt" && claude -p "$prompt" \
      --name "$name#$number - $title" \
      --allowedTools "${ALLOWED_TOOLS[@]}" \
      --permission-mode acceptEdits \
      --max-turns "$MAX_TURNS" \
      --output-format json \
      --json-schema "$RESULT_SCHEMA" \
      --settings "$CLAUDE_SETTINGS") </dev/null >"$logfile" 2>&1 || rc=$?

  # Parse the agent's response ('jq' is a CLI tool that parses JSON)
  local status summary decisions question
  status=$(jq -r '.structured_output.status // empty' "$logfile" 2>/dev/null || true)
  summary=$(jq -r '.structured_output.summary // .result // empty' "$logfile" 2>/dev/null || true)
  decisions=$(jq -r '.structured_output.decisions // [] | map("- " + .) | join("\n")' "$logfile" 2>/dev/null || true)
  question=$(jq -r '.structured_output.question // empty' "$logfile" 2>/dev/null || true)
  [[ -n "$decisions" ]] && decisions="
### Agent decisions
*push back on the PR if any are wrong*
$decisions"

  # Appended to failure comments: a command the reviewer can paste to land in the worktree
  local wt_cmd="Worktree on the runner:
\`\`\`sh
cd $wt
\`\`\`"

  # Check if there are any commits on the branch,
  # if there are, push them to the origin
  local has_commits=false out
  [[ -n $(git -C "$wt" log --oneline "$start..HEAD" 2>/dev/null) ]] && has_commits=true
  # This function runs with errexit off (its caller uses ||), so failures are checked by hand
  if $has_commits && ! out=$(git -C "$wt" push --quiet origin "HEAD:refs/heads/$branch" 2>&1); then
    log "Push failed for $repo#$number: $out"
    finish "$LABEL_FAILED" "🤖 **Couldn't push \`$branch\`, so no PR was opened or updated.** The work is committed in the worktree; re-adding \`$LABEL_TRIGGER\` continues from it.

$(failure_reason "$out")
$([[ "$status" == "needs_human" ]] && echo "
The agent was also blocked on a question:

${question:-$summary}
")
$wt_cmd"
    return 1
  fi

  local pr_url
  pr_url=$(gh pr list -R "$repo" --head "$branch" --state open --json url --jq '.[0].url // empty')

  # If the agent run failed, finish the issue by adding the '$LABEL_FAILED' label
  if (( rc != 0 )) || [[ -z "$status" ]]; then
    log "Failed $repo#$number (exit $rc)"
    finish "$LABEL_FAILED" "🤖 The agent run failed (exit code $rc).$($has_commits && echo " Partial work is on \`$branch\`.")

Log on the runner: \`$logfile\`

$wt_cmd"
  elif [[ "$status" == "needs_human" ]]; then
    log "Needs human: $repo#$number"
    finish "$LABEL_NEEDS_HUMAN" "🤖 **Blocked, needs your input.**

${question:-$summary}
$($has_commits && echo "
Progress so far is on \`$branch\`.")
Reply in a comment, then re-add the \`$LABEL_TRIGGER\` label to continue."
  elif ! $has_commits && [[ -n "$pr_url" ]]; then
    # A follow-up that needed an answer rather than code; the PR is still up for review
    log "Replied: $repo#$number"
    finish "$LABEL_PR" "🤖 $summary"
  elif ! $has_commits && [[ -z $(git -C "$wt" log --oneline "origin/$base..HEAD" 2>/dev/null) ]]; then
    # (A pushed branch that is ahead of the base but has no PR, e.g. because opening
    # it failed last time, falls through to the PR step instead.)
    log "No commits: $repo#$number"
    finish "$LABEL_FAILED" "🤖 The agent finished without committing anything.

$summary

$wt_cmd"
  else
    local verb=Updated failed=false
    if [[ -n "$pr_url" ]]; then
      out=$(gh pr comment "$pr_url" --body "🤖 Pushed an update for #$number.

$summary
$decisions" 2>&1) || failed=true
    else
      verb=Opened
      out=$(gh pr create -R "$repo" --base "$base" --head "$branch" --title "$title" \
        --body "Closes #$number.

$summary
$decisions" 2>&1) || failed=true
      pr_url=$(grep -Eo 'https://[^[:space:]]+/pull/[0-9]+' <<<"$out" | tail -n 1 || true)
      [[ -n "$pr_url" ]] || failed=true
    fi
    if $failed; then
      log "PR step failed for $repo#$number: $out"
      finish "$LABEL_FAILED" "🤖 **Pushed \`$branch\`, but couldn't $([[ $verb == Opened ]] && echo "open a PR" || echo "comment on $pr_url").**

$(failure_reason "$out")

$wt_cmd"
      return 1
    fi
    log "PR: $pr_url"
    finish "$LABEL_PR" "🤖 $verb $pr_url"
  fi
}

# Remove the worktrees (and local branches) of issues that have been closed,
# e.g. by merging their PR
cleanup_worktrees() {
  local dir=$1 repo=$2 name wt number
  name=$(basename "$dir")
  for wt in "$WORKTREE_ROOT/$name"-*; do
    number=${wt##*-}
    [[ -d "$wt" && "$number" =~ ^[0-9]+$ ]] || continue
    [[ $(gh issue view "$number" -R "$repo" --json state --jq .state 2>/dev/null) == CLOSED ]] || continue
    log "Removing worktree for closed $repo#$number"
    git -C "$dir" worktree remove --force "$wt" || true
    git -C "$dir" branch -D "agent/issue-$number" >/dev/null 2>&1 || true
  done
}

[[ -f "$CONFIG" ]] || { echo "No config at $CONFIG (see repos.example)" >&2; exit 1; }


# THE ACTUAL EXECUTION LOOP
# ---------------------------------------------------------------------------------
# It reads the CONFIG file line by line (each line is a repository),
# and for each repository, it processes issues carrying the trigger label
while read -r dir links <&3; do
  [[ -z "$dir" || "$dir" == \#* ]] && continue
  dir=${dir/#\~/$HOME}

  repo=$(gh repo view "$(git -C "$dir" remote get-url origin)" --json nameWithOwner --jq .nameWithOwner)
  base=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name)
  $DRY_RUN || ensure_labels "$repo"
  $DRY_RUN || cleanup_worktrees "$dir" "$repo"

  # Gets only issues still carrying the trigger label, and applies a label requiring
  # triage/write access, so outsiders can't queue work.
  mapfile -t numbers < <(gh issue list -R "$repo" --state open --label "$LABEL_TRIGGER" \
    --json number,labels \
    --jq ".[] | select([.labels[].name] | index(\"$LABEL_WIP\") | not) | .number")

  # Plus issues whose PR asks for a run: the trigger label on the PR, or a new code review.
  # Skipped while the issue is agent-wip, like the label on the issue itself.
  mapfile -t wip < <(gh issue list -R "$repo" --state all --label "$LABEL_WIP" --json number --jq '.[].number')
  declare -A pr_reasons=()
  while read -r n reason; do
    [[ -n "$n" && " ${wip[*]} " != *" $n "* ]] || continue
    pr_reasons[$n]=$reason
    [[ " ${numbers[*]} " == *" $n "* ]] || numbers+=("$n")
  done < <(pr_triggers "$repo")

  (( ${#numbers[@]} )) || { log "$repo: no issues or PRs labeled '$LABEL_TRIGGER', no new code reviews"; continue; }

  for n in "${numbers[@]}"; do
    process_issue "$dir" "$repo" "$base" "$links" "$n" "${pr_reasons[$n]:-}" || log "Error processing $repo#$n"
  done
done 3< "$CONFIG"
